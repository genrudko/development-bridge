@@ -185,8 +185,22 @@ class Marshaller:
                     "PERISCOPE could not hand the request to Fusion's main thread.",
                     detail="fireCustomEvent failed: {0}".format(exc),
                 )
-            remaining = max(0.0, deadline - time.time())
