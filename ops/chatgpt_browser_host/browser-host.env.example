# Current physical ChatGPT conversation for the logical route.
# This is a bootstrap binding, not the final routing architecture.
BROWSER_HOST_ROUTE_ID=ad5x
BROWSER_HOST_TARGET_URL=https://chatgpt.com/g/PROJECT_ID/c/CONVERSATION_ID
BROWSER_HOST_CHANNEL_ID=telegram-supervisor

# Used to prove that X polling is coming from this VPS rather than another browser.
BROWSER_HOST_PUBLIC_IP=
BROWSER_HOST_BRIDGE_UNIT=development-bridge.service

BROWSER_HOST_DISPLAY=:99
BROWSER_HOST_DEBUG_PORT=9222
BROWSER_HOST_CHECK_INTERVAL=5
BROWSER_HOST_STARTUP_TIMEOUT=45
BROWSER_HOST_POLL_WINDOW=15
BROWSER_HOST_POLL_GRACE=45
BROWSER_HOST_LISTENER_RECOVERY_TIMEOUT=120

# Normally these defaults do not need overriding.
# BROWSER_HOST_CHROME=/home/USER/.local/chrome-cft/chrome-linux64/chrome
# BROWSER_HOST_CHROME_LIB=/home/USER/.local/chrome-cft/runtime-libs/usr/lib/x86_64-linux-gnu
# BROWSER_HOST_XVFB=/home/USER/.local/xvfb-local/root/usr/bin/Xvfb
# BROWSER_HOST_XVFB_LIB=/home/USER/.local/xvfb-local/root/usr/lib/x86_64-linux-gnu
# BROWSER_HOST_PROFILE=/home/USER/.local/chrome-cft/profile
# BROWSER_HOST_STATE_DIR=/home/USER/.local/state/development-bridge/browser-host
