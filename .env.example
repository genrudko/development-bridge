# Development Bridge configuration and optional server overrides.
DEVELOPMENT_BRIDGE_CONFIG=/absolute/path/to/bridge.yaml
# DEVELOPMENT_BRIDGE_HOST=127.0.0.1
# DEVELOPMENT_BRIDGE_PORT=8789
# Optional bearer token enabling POST /mcp/x/coordinator/trigger.
# DEVELOPMENT_BRIDGE_X_TRIGGER_TOKEN=replace-with-a-long-random-token
# DEVELOPMENT_BRIDGE_DESKTOP_NODE_TOKEN=replace-with-a-long-random-token
# Required only when oauth.enabled is true. Generate a salted scrypt verifier with:
# .venv/bin/python -c 'from app.auth import create_owner_verifier; import getpass; print(create_owner_verifier(getpass.getpass()))'
# DEVELOPMENT_BRIDGE_OWNER_VERIFIER=scrypt$...
# Optional alternatives to knowledge.telegram config values.
# DEVELOPMENT_BRIDGE_TELEGRAM_API_ID=12345
# DEVELOPMENT_BRIDGE_TELEGRAM_API_HASH=replace-with-my-telegram-api-hash
# DEVELOPMENT_BRIDGE_TELEGRAM_SESSION_PATH=/absolute/path/to/telegram.session
# Optional direct coordinator wake delivery (disabled by default).
# DEVELOPMENT_BRIDGE_COORDINATOR_WAKE_ENABLED=false
# DEVELOPMENT_BRIDGE_COORDINATOR_WAKE_PRIMARY_TRANSPORT=review-gpt
# DEVELOPMENT_BRIDGE_COORDINATOR_WAKE_POLL_INTERVAL_SECONDS=5.0
# DEVELOPMENT_BRIDGE_REVIEW_GPT_NODE=/path/to/node
# DEVELOPMENT_BRIDGE_REVIEW_GPT_CLI_PATH=/path/to/review-gpt/dist/cli.js
# DEVELOPMENT_BRIDGE_REVIEW_GPT_CONFIG_PATH=/path/to/review-gpt.config.json
# DEVELOPMENT_BRIDGE_REVIEW_GPT_BROWSER_ENDPOINT=http://127.0.0.1:9222
# DEVELOPMENT_BRIDGE_REVIEW_GPT_RECEIPT_DIRECTORY=/path/to/receipts
# DEVELOPMENT_BRIDGE_REVIEW_GPT_PROCESS_TIMEOUT_SECONDS=60.0
